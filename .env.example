# === MySQL 连接（TPC-C MySQL 选项 + 管理库） ===
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_PASSWORD=your_playground_password_here
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_APP_USER=playground_app
DB_APP_PASSWORD=your_playground_app_password_here
DB_ADMIN_DATABASE=playground_admin
DB_TEMPLATE_DATABASE=playground_template

# === PostgreSQL 连接（演示沙箱 + TPC-C PG 选项） ===
PG_HOST=postgres
PG_PORT=5432
PG_USER=playground
PG_PASSWORD=your_pg_password_here
PG_APP_USER=playground_app
PG_APP_PASSWORD=your_pg_app_password_here
PG_DATABASE=rucdbcloud
PG_TEMPLATE_SCHEMA=playground_template
PG_ADMIN_SCHEMA=playground_admin

# === 会话配置 ===
SESSION_TTL_HOURS=24

# === 安全限制 ===
MAX_ROWS_PER_QUERY=1000
MAX_DB_SIZE_MB=100
MAX_TABLES_PER_USER=50
MAX_SQL_LENGTH_KB=10
RATE_LIMIT_PER_MINUTE=300
GLOBAL_RATE_PER_MINUTE=1200
CREATE_SESSION_PER_MINUTE=20
MAX_ACTIVE_SANDBOXES=200
MAX_SANDBOXES_PER_IP=3
MAX_STATEMENTS_PER_REQUEST=10
QUERY_TIMEOUT_SECONDS=30

# === 清理任务 ===
CLEANUP_INTERVAL_MINUTES=30

# === 服务端口 ===
PORT=3001
